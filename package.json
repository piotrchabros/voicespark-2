{
  "name": "voicespark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @voicespark/web --filter @voicespark/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:corpus": "pnpm --filter @voicespark/filters test:corpus",
    "test:corpus:live": "pnpm --filter @voicespark/filters test:corpus:live",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:import-load": "pnpm --filter @voicespark/worker test:import-load",
    "test:e2e": "pnpm --filter @voicespark/web test:e2e",
    "test:admin-isolation": "pnpm --filter @voicespark/web test:admin-isolation",
    "db:migrate": "pnpm --filter @voicespark/db migrate",
    "db:seed": "pnpm --filter @voicespark/db seed",
    "cli": "pnpm --filter @voicespark/core cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
