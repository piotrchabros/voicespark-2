{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@voicespark/core": ["./packages/core/src/index.ts"],
      "@voicespark/core/*": ["./packages/core/src/*"],
      "@voicespark/db": ["./packages/db/src/index.ts"],
      "@voicespark/db/*": ["./packages/db/src/*"],
      "@voicespark/filters": ["./packages/filters/src/index.ts"],
      "@voicespark/filters/*": ["./packages/filters/src/*"],
      "@voicespark/integrations": ["./packages/integrations/src/index.ts"],
      "@voicespark/integrations/*": ["./packages/integrations/src/*"]
    }
  }
}
