{
  "name": "@voicespark/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:import-load": "vitest run --project import-load --passWithNoTests",
    "hub:eval": "tsx --env-file-if-exists=../../.env eval/hub/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@googleapis/gmail": "^22.0.2",
    "@secretlint/core": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@voicespark/core": "workspace:*",
    "@voicespark/db": "workspace:*",
    "@voicespark/filters": "workspace:*",
    "@voicespark/integrations": "workspace:*",
    "arctic": "^3.7.0",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "email-reply-parser": "^2.3.9",
    "file-type": "^22.2.0",
    "franc": "^6.2.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.15",
    "mailparser": "^3.12.2",
    "mammoth": "^1.13.0",
    "mustache": "^4.2.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "supermemory": "^5.0.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
