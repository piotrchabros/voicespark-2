# Copy to .env. Generate secrets with: openssl rand -base64 32
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgres://voicespark:voicespark@localhost:5432/voicespark
REDIS_URL=redis://localhost:6379

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
BETTER_AUTH_URL=http://localhost:3000

# Sign-in providers
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MICROSOFT_SIGNIN_CLIENT_ID=
MICROSOFT_SIGNIN_CLIENT_SECRET=
MICROSOFT_SIGNIN_TENANT_ID=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Mailbox access (separate OAuth apps from sign-in)
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT_ID=common

# JSON keyring of base64 32-byte keys; active id must exist in the keyring
ENCRYPTION_KEYRING={"k1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
ENCRYPTION_ACTIVE_KEY_ID=k1
DEDUP_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Required (non-empty) when NODE_ENV=production
SUPERMEMORY_API_KEY=
# v3 = self-hosted server (default). v5 = hosted api.supermemory.ai; then set SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_API_VERSION=v3
SUPERMEMORY_BASE_URL=https://supermemory.voicespark.ai
# Test-only: enables the live v3 contract test. Use a dedicated test key and instance.
# SUPERMEMORY_V3_TEST_URL=
# SUPERMEMORY_V3_TEST_KEY=
ANTHROPIC_API_KEY=
LLM_PROFILE_MODEL=claude-sonnet-5-5
LLM_DRAFT_MODEL=claude-sonnet-5-5
LLM_CLASSIFIER_MODEL=claude-haiku-5-5
LLM_ALLOWED_MODELS=claude-sonnet-5-5,claude-opus-5-5
# Context Hub extraction; the model defaults to LLM_PROFILE_MODEL when unset
LLM_HUB_EXTRACTION_MODEL=
LLM_HUB_EXTRACTION_EFFORT=medium

SMTP_URL=smtp://user:pass@localhost:587
MAIL_FROM=VoiceSpark <noreply@example.com>

UPLOAD_TMP_DIR=/data/uploads-tmp
UPLOAD_MAX_BYTES=10485760
HUB_FILES_DIR=/data/hub-files
HUB_FILE_MAX_BYTES=26214400
WORKER_CONCURRENCY_IMPORT=8
WORKER_CONCURRENCY_LLM=4
# Must be <= 10 (startup refuses otherwise)
SYNC_POLL_INTERVAL_MINUTES=5

# Test-only auth bypass. Never set in production (startup refuses).
# AUTH_TEST_MODE=1
